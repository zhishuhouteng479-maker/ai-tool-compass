{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"AI Tool Compass \u3078\u3088\u3046\u3053\u305d","text":"<p>\u5f53\u30b5\u30a4\u30c8\u3067\u306f\u3001\u6700\u65b0\u306eAI\u30c4\u30fc\u30eb\u3084\u696d\u52d9\u52b9\u7387\u5316SaaS\u3092\u5fb9\u5e95\u7684\u306b\u691c\u8a3c\u3057\u3001\u8aad\u8005\u306e\u7686\u69d8\u306e\u751f\u7523\u6027\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u30c4\u30fc\u30eb\u3092\u3054\u63d0\u6848\u3057\u307e\u3059\u3002</p>"},{"location":"#_1","title":"\u6ce8\u76ee\u306e\u30ab\u30c6\u30b4\u30ea\u30fc","text":"<ul> <li>\u751f\u6210AI\u30c4\u30fc\u30eb (Generative AI)</li> <li>\u30ce\u30fc\u30b3\u30fc\u30c9\u958b\u767a (No-Code)</li> <li>SEO\u30fb\u30de\u30fc\u30b1\u30c6\u30a3\u30f3\u30b0\u81ea\u52d5\u5316</li> </ul> <p>\u203b\u5f53\u30b5\u30a4\u30c8\u306f\u81ea\u5f8b\u578bAI\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u306b\u3088\u3063\u3066\u3001\u5e38\u306b\u6700\u65b0\u306e\u691c\u7d22\u30c8\u30ec\u30f3\u30c9\u3068\u60c5\u5831\u306b\u57fa\u3065\u304d\u81ea\u52d5\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3055\u308c\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"articles/accounting-tools/","title":"\u30102026\u5e74\u6700\u65b0\u7d50\u8ad6\u3011\u30af\u30e9\u30a6\u30c9\u4f1a\u8a08\u30bd\u30d5\u30c8\u5fb9\u5e95\u6bd4\u8f03\uff1a\u500b\u4eba\u4e8b\u696d\u4e3b\u306b\u304a\u3059\u3059\u3081\u306e3\u9078","text":"<p>\u203b\u3053\u306e\u8a18\u4e8b\u306b\u306fPR\uff08\u30d7\u30ed\u30e2\u30fc\u30b7\u30e7\u30f3\uff09\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"articles/accounting-tools/#20263","title":"\u30102026\u5e74\u6700\u65b0\u7d50\u8ad6\u3011\u30af\u30e9\u30a6\u30c9\u4f1a\u8a08\u30bd\u30d5\u30c8\u5fb9\u5e95\u6bd4\u8f03\uff1a\u500b\u4eba\u4e8b\u696d\u4e3b\u306b\u304a\u3059\u3059\u3081\u306e3\u9078","text":"<p>\u300c\u78ba\u5b9a\u7533\u544a\u306e\u6642\u671f\u306b\u307e\u3068\u3081\u3066\u3084\u308c\u3070\u3044\u3044\u3084\u300d \u3082\u3057\u3042\u306a\u305f\u304c\u4eca\u305d\u3046\u8003\u3048\u3066\u3044\u308b\u306a\u3089\u3001\u975e\u5e38\u306b\u5371\u967a\u3067\u3059\u3002</p> <p>2026\u5e74\u306e\u30a4\u30f3\u30dc\u30a4\u30b9\u5236\u5ea6\u3084\u96fb\u5b50\u5e33\u7c3f\u4fdd\u5b58\u6cd5\u306e\u53b3\u683c\u5316\u306b\u3088\u308a\u3001\u624b\u4f5c\u696d\u3067\u306e\u7d4c\u7406\u30df\u30b9\u306f\u5373\u300c\u8ffd\u5fb4\u8ab2\u7a0e\u300d\u3084\u300c\u6570\u5341\u4e07\u5186\u306e\u7f70\u91d1\u300d\u306b\u76f4\u7d50\u3059\u308b\u6642\u4ee3\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u6708\u984d2,000\u5186\u524d\u5f8c\u306e\u30af\u30e9\u30a6\u30c9\u4f1a\u8a08\u30bd\u30d5\u30c8\u3078\u306e\u6295\u8cc7\u3092\u6e0b\u308b\u3053\u3068\u3067\u3001\u3042\u306a\u305f\u306f\u6bce\u6708\u81a8\u5927\u306a\u6642\u9593\u306e\u7121\u99c4\u3068\u3001\u4e8b\u696d\u3092\u63fa\u308b\u304c\u3059\u7a0e\u52d9\u30ea\u30b9\u30af\u3092\u80cc\u8ca0\u3044\u7d9a\u3051\u3066\u3044\u308b\u306e\u3067\u3059\u3002</p> <p>\u672c\u8a18\u4e8b\u3067\u306f\u3001\u3059\u3079\u3066\u306e\u4f1a\u8a08\u30bd\u30d5\u30c8\u3092\u691c\u8a3c\u3057\u305f\u5f53\u30b5\u30a4\u30c8\u304c\u5c0e\u304d\u51fa\u3057\u305f\u300c\u30af\u30e9\u30a6\u30c9\u4f1a\u8a08\u30bd\u30d5\u30c8\u306e\u7d50\u8ad6\u300d\u3068\u3057\u3066\u3001\u7d76\u5bfe\u306b\u5c0e\u5165\u3059\u3079\u304d\u30c8\u30c3\u30d73\u793e\u3092\u6bd4\u8f03\u3057\u3001\u9577\u6240\u30fb\u77ed\u6240\u3092\u307e\u3068\u3081\u307e\u3057\u305f\u3002</p>"},{"location":"articles/accounting-tools/#10","title":"\ud83e\udd16 10\u79d2\u8a3a\u65ad\uff1a\u3042\u306a\u305f\u306b\u6700\u9069\u306a\u4f1a\u8a08\u30bd\u30d5\u30c8\u306f\uff1f","text":"<p>\u7c3f\u8a18\u306e\u77e5\u8b58\u306f\u3042\u308a\u307e\u3059\u304b\uff1f</p> \u77e5\u8b58\u30bc\u30ed\uff08\u3068\u306b\u304b\u304f\u7c21\u5358\u306b\uff09 \u3042\u308b\u7a0b\u5ea6\u308f\u304b\u308b\uff08\u81ea\u52d5\u5316\u91cd\u8996\uff09 <p></p>"},{"location":"articles/accounting-tools/#3","title":"\ud83d\udcca \u30af\u30e9\u30a6\u30c9\u4f1a\u8a08\u30bd\u30d5\u30c8 \u30c8\u30c3\u30d73\u793e \u6bd4\u8f03\u8868","text":"\u30c4\u30fc\u30eb\u540d \u521d\u5fc3\u8005\u5411\u3051 \u81ea\u52d5\u5316\u306e\u5f37\u3055 \u6708\u984d\u6599\u91d1\uff08\u76ee\u5b89\uff09 \u30e6\u30fc\u30b6\u30fc\u306e\u53e3\u30b3\u30df\uff08\u533f\u540d\uff09 \u8a73\u7d30\u30ec\u30d3\u30e5\u30fc freee\u4f1a\u8a08 \u25ce \u6700\u5f37 \u3007 \u7d041,980\u5186\u301c \u300c\u30b9\u30de\u30db\u306e\u30ec\u30b7\u30fc\u30c8\u64ae\u5f71\u3060\u3051\u3067\u307b\u307c\u7d42\u308f\u308b\u300d \ud83d\udd17freee\u306e\u5358\u72ec\u30ec\u30d3\u30e5\u30fc\u8a18\u4e8b\u3078 \u30de\u30cd\u30fc\u30d5\u30a9\u30ef\u30fc\u30c9 \u3007 \u25ce \u6700\u5f37 \u7d041,280\u5186\u301c \u300c\u65e2\u5b58\u306e\u7a0e\u7406\u58eb\u3068\u7121\u6599\u3067\u5171\u6709\u3067\u304d\u3066\u79fb\u884c\u304c\u30e9\u30af\u300d \ud83d\udd17\u30de\u30cd\u30d5\u30a9\u306e\u5358\u72ec\u30ec\u30d3\u30e5\u30fc\u8a18\u4e8b\u3078 \u5f25\u751f\u30b7\u30ea\u30fc\u30ba \u3007 \u25b3 \u521d\u5e74\u5ea6\u7121\u6599\u301c \u300c\u6614\u304b\u3089\u3042\u308b\u30d6\u30e9\u30f3\u30c9\u306a\u306e\u3067\u5b89\u5fc3\u611f\u304c\u9055\u3046\u300d \ud83d\udd17\u5f25\u751f\u306e\u5358\u72ec\u30ec\u30d3\u30e5\u30fc\u8a18\u4e8b\u3078"},{"location":"articles/accounting-tools/#1-freee","title":"1. freee\u4f1a\u8a08 (\u30d5\u30ea\u30fc)","text":"<p>\u7c3f\u8a18\u306e\u77e5\u8b58\u304c\u306a\u304f\u3066\u3082\u300c\u3007\u3007\u3092\u8cb7\u3063\u305f\u300d\u3068\u5165\u529b\u3059\u308b\u3060\u3051\u3067\u81ea\u52d5\u4ed5\u8a33\u3055\u308c\u308b\u3001\u5727\u5012\u7684\u306a\u521d\u5fc3\u8005\u5411\u3051\u8a2d\u8a08\u304c\u6700\u5927\u306e\u30e1\u30ea\u30c3\u30c8\u3067\u3059\u3002</p> <ul> <li>\u9577\u6240: \u76f4\u611f\u7684\u306aUI\u3002\u30b9\u30de\u30db\u30a2\u30d7\u30ea\u306e\u5b8c\u6210\u5ea6\u304c\u6700\u3082\u9ad8\u3044\u3002</li> <li>\u77ed\u6240: \u7c3f\u8a18\u306b\u6163\u308c\u3066\u3044\u308b\u4eba\u306b\u306f\u72ec\u81ea\u306eUI\u304c\u4f7f\u3044\u3065\u3089\u304f\u611f\u3058\u308b\u5834\u5408\u304c\u3042\u308b\u3002</li> </ul> <p>\ud83d\udc49 freee\u4f1a\u8a08 \u516c\u5f0f\u30b5\u30a4\u30c8\u3067\u7121\u6599\u3067\u304a\u8a66\u3057</p>"},{"location":"articles/accounting-tools/#2","title":"2. \u30de\u30cd\u30fc\u30d5\u30a9\u30ef\u30fc\u30c9 \u30af\u30e9\u30a6\u30c9\u78ba\u5b9a\u7533\u544a","text":"<p>\u4ed6\u30b5\u30fc\u30d3\u30b9\uff08\u9280\u884c\u3001\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u3001\u30ec\u30b8\u3001EC\u30b5\u30a4\u30c8\uff09\u3068\u306e\u9023\u643a\u529b\u304c\u5727\u5012\u7684\u3067\u3059\u3002\u73fe\u72b6\u7dad\u6301\u30d0\u30a4\u30a2\u30b9\uff08\u4eca\u306e\u7a0e\u7406\u58eb\u3068\u306e\u5951\u7d04\u304c\u3042\u308b\u304b\u3089\u2026\uff09\u3067\u60a9\u3080\u65b9\u3082\u5b89\u5fc3\u3002\u7a0e\u7406\u58eb\u3082\u7121\u6599\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u30ed\u30b0\u30a4\u30f3\u3067\u304d\u308b\u305f\u3081\u3001\u79fb\u884c\u30b3\u30b9\u30c8\u304c\u6700\u3082\u4f4e\u3044\u3067\u3059\u3002</p> <ul> <li>\u9577\u6240: \u30c7\u30fc\u30bf\u9023\u643a\u6570No.1\u3002\u4e8b\u696d\u304c\u62e1\u5927\u3057\u3066\u3082\u305d\u306e\u307e\u307e\u4f7f\u3048\u308b\u62e1\u5f35\u6027\u3002</li> <li>\u77ed\u6240: \u521d\u671f\u8a2d\u5b9a\u3067\u9023\u643a\u9805\u76ee\u304c\u591a\u3044\u3068\u5c11\u3057\u624b\u9593\u304c\u304b\u304b\u308b\u3002</li> </ul> <p>\ud83d\udc49 \u30de\u30cd\u30fc\u30d5\u30a9\u30ef\u30fc\u30c9 \u30af\u30e9\u30a6\u30c9\u78ba\u5b9a\u7533\u544a \u516c\u5f0f\u30b5\u30a4\u30c8\u3078</p>"},{"location":"articles/accounting-tools/#3_1","title":"3. \u5f25\u751f\u30b7\u30ea\u30fc\u30ba (\u3084\u3088\u3044\u306e\u9752\u8272\u7533\u544a\u30aa\u30f3\u30e9\u30a4\u30f3)","text":"<p>\u5727\u5012\u7684\u306a\u58f2\u4e0a\u5b9f\u7e3eNo.1\u3002\u9577\u5e74\u306e\u4fe1\u983c\u3068\u624b\u539a\u3044\u96fb\u8a71\u30b5\u30dd\u30fc\u30c8\u4f53\u5236\u304c\u3042\u308a\u3001\u521d\u3081\u3066\u306e\u78ba\u5b9a\u7533\u544a\u3067\u3082\u7a0e\u52d9\u7f72\u30ec\u30d9\u30eb\u306e\u5b89\u5fc3\u611f\u304c\u5f97\u3089\u308c\u307e\u3059\u3002</p> <ul> <li>\u9577\u6240: \u521d\u5e74\u5ea6\u7121\u6599\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u304c\u5f37\u529b\u3002\u30b5\u30dd\u30fc\u30c8\u304c\u624b\u539a\u3044\u3002</li> <li>\u77ed\u6240: \u753b\u9762\u30c7\u30b6\u30a4\u30f3\u304c\u3084\u3084\u53e4\u304f\u611f\u3058\u308b\u3002</li> </ul> <p>\ud83d\udc49 \u5f25\u751f\u30b7\u30ea\u30fc\u30ba \u516c\u5f0f\u30b5\u30a4\u30c8\u3078</p> <p>\u7d50\u8ad6\uff1a \u3068\u306b\u304b\u304f\u697d\u3092\u3057\u305f\u3044\u306a\u3089<code>freee</code>\u3001\u5c06\u6765\u7684\u306a\u4e8b\u696d\u62e1\u5927\u3068\u81ea\u52d5\u5316\u3092\u72d9\u3046\u306a\u3089<code>\u30de\u30cd\u30fc\u30d5\u30a9\u30ef\u30fc\u30c9</code>\u3092\u9078\u3079\u3070\u9593\u9055\u3044\u3042\u308a\u307e\u305b\u3093\u3002\u4eca\u65e5\u3001\u6700\u521d\u306e1\u6b69\u3092\u8e0f\u307f\u51fa\u3057\u3066\u7a0e\u52d9\u30ea\u30b9\u30af\u304b\u3089\u89e3\u653e\u3055\u308c\u307e\u3057\u3087\u3046\u3002</p>"},{"location":"articles/doraverse-review/","title":"Doraverse\u306e\u8a55\u5224\u3068\u4f7f\u3044\u65b9\uff1a\u8907\u6570AI\u30b5\u30d6\u30b9\u30af\u3092\u4e00\u672c\u5316\u3059\u308b\u6700\u5f37\u30c4\u30fc\u30eb","text":"<p>ChatGPT\u3001Claude\u3001Midjourney... \u6709\u80fd\u306aAI\u30c4\u30fc\u30eb\u304c\u5897\u3048\u308b\u4e00\u65b9\u3067\u3001\u5168\u3066\u3092\u5951\u7d04\u3059\u308b\u3068\u6708\u984d\u30b3\u30b9\u30c8\u306f\u6570\u4e07\u5186\u306b\u81a8\u308c\u4e0a\u304c\u308a\u307e\u3059\u3002 \u305d\u3053\u3067\u73fe\u5728\u3001\u6cd5\u4eba\u306e\u30b3\u30b9\u30c8\u524a\u6e1b\u3068\u696d\u52d9\u52b9\u7387\u5316\u306e\u5207\u308a\u672d\u3068\u3057\u3066\u6ce8\u76ee\u3055\u308c\u3066\u3044\u308b\u306e\u304c\u300cDoraverse\u300d\u3067\u3059\u3002</p>"},{"location":"articles/doraverse-review/#doraverse","title":"Doraverse\u3068\u306f\uff1f","text":"<p>\u8907\u6570\u306e\u6700\u9ad8\u5cf0AI\u30e2\u30c7\u30eb\u30921\u3064\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u4f7f\u3044\u5012\u305b\u308bBtoB\u5411\u3051SaaS\u3067\u3059\u3002\u30c1\u30fc\u30e0\u5168\u4f53\u3067AI\u306e\u77e5\u80fd\u3092\u5171\u6709\u3057\u3001\u5727\u5012\u7684\u306a\u751f\u7523\u6027\u5411\u4e0a\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002</p> <p>\ud83d\udc49 \u6708\u984d\u6599\u91d1\u3092\u8ce2\u304f\u96c6\u7d04\u3002\u8907\u6570\u306eAI\u30b5\u30d6\u30b9\u30af\u30921\u3064\u306b\u307e\u3068\u3081\u3066\u3001\u6700\u9ad8\u5cf0\u306e\u77e5\u80fd\u3092\u4f7f\u3044\u5012\u3059\u306a\u3089Doraverse\u3002</p>"},{"location":"articles/programming-schools-comparison/","title":"\u30102026\u5e74\u6700\u65b0\u3011\u672a\u7d4c\u9a13\u304b\u3089\u7a3c\u3052\u308b\uff01\u304a\u3059\u3059\u3081\u30d7\u30ed\u30b0\u30e9\u30df\u30f3\u30b0\u30b9\u30af\u30fc\u30eb\u6bd4\u8f03\u3068\u7d50\u8ad6","text":"<p>\u203b\u3053\u306e\u8a18\u4e8b\u306b\u306fPR\uff08\u30d7\u30ed\u30e2\u30fc\u30b7\u30e7\u30f3\uff09\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"articles/programming-schools-comparison/#2026","title":"\u30102026\u5e74\u6700\u65b0\u3011\u672a\u7d4c\u9a13\u304b\u3089\u7a3c\u3052\u308b\uff01\u304a\u3059\u3059\u3081\u30d7\u30ed\u30b0\u30e9\u30df\u30f3\u30b0\u30b9\u30af\u30fc\u30eb\u6bd4\u8f03\u3068\u7d50\u8ad6","text":"<p>\u300c\u4eca\u306e\u4ed5\u4e8b\u306e\u307e\u307e\u3067\u5c06\u6765\u5927\u4e08\u592b\u3060\u308d\u3046\u304b\u2026\u300d \u300cAI\u306b\u4ed5\u4e8b\u3092\u596a\u308f\u308c\u308b\u524d\u306b\u3001AI\u3092\u4f5c\u308b\u5074\u306b\u56de\u308a\u305f\u3044\u300d</p> <p>\u305d\u3046\u601d\u3063\u3066\u30d7\u30ed\u30b0\u30e9\u30df\u30f3\u30b0\u5b66\u7fd2\u3092\u59cb\u3081\u3088\u3046\u3068\u3057\u3066\u3082\u3001\u72ec\u5b66\u3067\u306e\u632b\u6298\u7387\u306f\u7d0490%\u3068\u8a00\u308f\u308c\u3066\u3044\u307e\u3059\u3002\u6642\u9593\u3092\u7121\u99c4\u306b\u3057\u3066\u81ea\u4fe1\u3092\u55aa\u5931\u3059\u308b\u524d\u306b\u3001\u30d7\u30ed\u306e\u74b0\u5883\uff08\u30b9\u30af\u30fc\u30eb\uff09\u306b\u81ea\u5df1\u6295\u8cc7\u3059\u308b\u306e\u304c\u3001\u7d50\u679c\u7684\u306b\u6700\u3082\u5b89\u4e0a\u304c\u308a\u3067\u78ba\u5b9f\u306a\u9078\u629e\u3067\u3059\u3002</p> <p>\u672c\u8a18\u4e8b\u3067\u306f\u3001\u5f53\u30b5\u30a4\u30c8\u304c\u53b3\u9078\u3057\u305f\u300c\u672c\u5f53\u306b\u7d50\u679c\u304c\u51fa\u308b\u30d7\u30ed\u30b0\u30e9\u30df\u30f3\u30b0\u30b9\u30af\u30fc\u30eb\u300d\u3092\u30c6\u30fc\u30de\u5225\u306b\u6bd4\u8f03\u3057\u3001\u3042\u306a\u305f\u306b\u6700\u9069\u306a\u9078\u3073\u65b9\u306e\u7d50\u8ad6\u3092\u51fa\u3057\u307e\u3059\u3002</p>"},{"location":"articles/programming-schools-comparison/#_1","title":"\ud83d\udcca \u30d7\u30ed\u30b0\u30e9\u30df\u30f3\u30b0\u30b9\u30af\u30fc\u30eb \u7279\u5fb4\u6bd4\u8f03\u8868","text":"\u30b9\u30af\u30fc\u30eb\u540d \u5f37\u307f\u30fb\u7279\u5316\u30b8\u30e3\u30f3\u30eb \u53d7\u8b1b\u30b9\u30bf\u30a4\u30eb \u30e6\u30fc\u30b6\u30fc\u306e\u53e3\u30b3\u30df\uff08\u533f\u540d\uff09 \u8a73\u7d30\u30ec\u30d3\u30e5\u30fc Python Winner AI\u30fb\u30c7\u30fc\u30bf\u30b5\u30a4\u30a8\u30f3\u30b9\uff08Python\u7279\u5316\uff09 \u30de\u30f3\u30c4\u30fc\u30de\u30f3 \u300cAI\u7279\u5316\u306a\u3089\u3053\u3053\u4e00\u629e\u3002\u672a\u7d4c\u9a13\u3067\u3082\u7406\u89e3\u3067\u304d\u305f\u300d \ud83d\udd17Python Winner\u306e\u5358\u72ec\u30ec\u30d3\u30e5\u30fc\u3078 Win\u30b9\u30af\u30fc\u30eb \u8cc7\u683c\u53d6\u5f97\u30fb\u624b\u5805\u3044\u5c31\u8077 \u500b\u4eba\u30ec\u30c3\u30b9\u30f3 \u300c\u8cc7\u683c\u304c\u53d6\u308c\u308b\u306e\u3067\u5c65\u6b74\u66f8\u306b\u66f8\u3051\u308b\u306e\u304c\u5f37\u3044\u300d \ud83d\udd17Win\u30b9\u30af\u30fc\u30eb\u306e\u5358\u72ec\u30ec\u30d3\u30e5\u30fc\u3078 WEBCOACH Web\u30c7\u30b6\u30a4\u30f3\u30fb\u526f\u696d\u30fb\u30d5\u30ea\u30fc\u30e9\u30f3\u30b9 \u30aa\u30f3\u30e9\u30a4\u30f3 \u300c\u5728\u5b85\u3067\u7a3c\u304e\u305f\u3044\u5973\u6027\u5411\u3051\u3002\u30b5\u30dd\u30fc\u30c8\u304c\u512a\u3057\u3044\u300d \ud83d\udd17WEBCOACH\u306e\u5358\u72ec\u30ec\u30d3\u30e5\u30fc\u3078"},{"location":"articles/programming-schools-comparison/#1-python-winnerai","title":"1. Python Winner\uff08AI\u30fb\u30c7\u30fc\u30bf\u30b5\u30a4\u30a8\u30f3\u30b9\u7279\u5316\uff09","text":"<p>\u3053\u308c\u304b\u3089\u306e\u6642\u4ee3\u306b\u6700\u3082\u9700\u8981\u304c\u9ad8\u307e\u308b\u300cAI\uff08Python\uff09\u300d\u306b\u7279\u5316\u3057\u3066\u5b66\u3073\u305f\u3044\u306a\u3089\u3053\u3053\u4e00\u629e\u3067\u3059\u3002</p> <ul> <li>\u9577\u6240: \u30de\u30f3\u30c4\u30fc\u30de\u30f3\u30ec\u30c3\u30b9\u30f3\u3067\u632b\u6298\u3057\u306b\u304f\u3044\u3002\u5c06\u6765\u6027\u306e\u9ad8\u3044AI\u4eba\u6750\u306b\u306a\u308c\u308b\u3002</li> <li>\u77ed\u6240: Python\u4ee5\u5916\u306e\u8a00\u8a9e\uff08Web\u5236\u4f5c\u306eHTML/CSS\u7b49\uff09\u3092\u5e83\u304f\u6d45\u304f\u5b66\u3073\u305f\u3044\u4eba\u306b\u306f\u4e0d\u5411\u304d\u3002</li> </ul> <p>\ud83d\udc49 Python Winner\u306e\u7121\u6599\u30ab\u30a6\u30f3\u30bb\u30ea\u30f3\u30b0\u306f\u3053\u3061\u3089</p>"},{"location":"articles/programming-schools-comparison/#2-win","title":"2. Win\u30b9\u30af\u30fc\u30eb\uff08\u8cc7\u683c\u53d6\u5f97\u30fb\u5c31\u8077\u91cd\u8996\uff09","text":"<p>\u300c\u3068\u306b\u304b\u304f\u5c65\u6b74\u66f8\u306b\u66f8\u3051\u308b\u8cc7\u683c\u304c\u6b32\u3057\u3044\u300d\u300c\u5b89\u5b9a\u3057\u305f\u4f01\u696d\u306b\u5c31\u8077\u30fb\u8ee2\u8077\u3057\u305f\u3044\u300d\u3068\u3044\u3046\u624b\u5805\u3044\u30ad\u30e3\u30ea\u30a2\u30a2\u30c3\u30d7\u3092\u72d9\u3046\u65b9\u306b\u304a\u3059\u3059\u3081\u3067\u3059\u3002</p> <ul> <li>\u9577\u6240: \u8cc7\u683c\u53d6\u5f97\u306b\u5727\u5012\u7684\u306b\u5f37\u3044\u3002\u5168\u56fd\u5c55\u958b\u3067\u901a\u5b66\u3082\u53ef\u80fd\u3002</li> <li>\u77ed\u6240: \u6700\u5148\u7aef\u306eAI\u30b9\u30bf\u30fc\u30c8\u30a2\u30c3\u30d7\u3068\u3044\u3046\u3088\u308a\u306f\u3001\u5b89\u5b9a\u5fd7\u5411\u306e\u30ab\u30ea\u30ad\u30e5\u30e9\u30e0\u3002</li> </ul> <p>\ud83d\udc49 Win\u30b9\u30af\u30fc\u30eb\u306e\u7121\u6599\u53d7\u8b1b\u76f8\u8ac7\u306f\u3053\u3061\u3089</p>"},{"location":"articles/programming-schools-comparison/#3-webcoachweb","title":"3. WEBCOACH\uff08\u526f\u696d\u30fb\u30d5\u30ea\u30fc\u30e9\u30f3\u30b9\u30fbWeb\u30c7\u30b6\u30a4\u30f3\uff09","text":"<p>\u30ac\u30c3\u30c4\u30ea\u3068\u30b7\u30b9\u30c6\u30e0\u958b\u767a\u3092\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u30d0\u30ca\u30fc\u4f5c\u6210\u3084LP\u5236\u4f5c\u306a\u3069\u300c\u5728\u5b85\u3067\u67085\u301c10\u4e07\u7a3c\u3050\u526f\u696d\u300d\u3084\u30d5\u30ea\u30fc\u30e9\u30f3\u30b9\u3092\u76ee\u6307\u3059\u65b9\u306b\u6700\u9069\u3067\u3059\u3002</p> <ul> <li>\u9577\u6240: \u30c7\u30b6\u30a4\u30f3\u30b9\u30ad\u30eb\u306b\u7279\u5316\u3002\u526f\u696d\u306e\u6848\u4ef6\u7372\u5f97\u30b5\u30dd\u30fc\u30c8\u304c\u3042\u308b\u3002</li> <li>\u77ed\u6240: \u9ad8\u5ea6\u306a\u30d7\u30ed\u30b0\u30e9\u30df\u30f3\u30b0\uff08\u30b7\u30b9\u30c6\u30e0\u69cb\u7bc9\uff09\u307e\u3067\u306f\u5b66\u3079\u306a\u3044\u3002</li> </ul> <p>\ud83d\udc49 WEBCOACH\u306e\u7121\u6599\u30ab\u30a6\u30f3\u30bb\u30ea\u30f3\u30b0\u306f\u3053\u3061\u3089</p> <p>\u7d50\u8ad6\uff1a  AI\u4eba\u6750\u3068\u3057\u3066\u4e00\u767a\u9006\u8ee2\u306e\u9ad8\u5e74\u53ce\u3092\u72d9\u3046\u306a\u3089<code>Python Winner</code>\u3002 \u8cc7\u683c\u3092\u53d6\u3063\u3066\u5805\u5b9f\u306b\u5c31\u8077\u30fb\u8ee2\u8077\u3059\u308b\u306a\u3089<code>Win\u30b9\u30af\u30fc\u30eb</code>\u3002 \u5728\u5b85\u30ef\u30fc\u30af\u3067\u526f\u696d\u30fb\u30d5\u30ea\u30fc\u30e9\u30f3\u30b9\u3068\u3057\u3066\u81ea\u7531\u306b\u50cd\u304d\u305f\u3044\u306a\u3089<code>WEBCOACH</code>\u3002</p> <p>\u307e\u305a\u306f\u7121\u6599\u30ab\u30a6\u30f3\u30bb\u30ea\u30f3\u30b0\u3092\u53d7\u3051\u3066\u3001\u30d7\u30ed\u306b\u76f4\u63a5\u30ad\u30e3\u30ea\u30a2\u306e\u60a9\u307f\u3092\u3076\u3064\u3051\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u884c\u52d5\u3057\u306a\u3051\u308c\u3070\u73fe\u5b9f\u306f1\u30df\u30ea\u3082\u5909\u308f\u308a\u307e\u305b\u3093\u3002</p>"},{"location":"articles/socialdog-review/","title":"SocialDog\u306e\u6599\u91d1\u30d7\u30e9\u30f3\u3068\u8a55\u5224\uff1aSNS\u904b\u7528\u3092\u5b8c\u5168\u81ea\u52d5\u5316\u3059\u308b\u65b9\u6cd5","text":"<p>X\uff08\u65e7Twitter\uff09\u3067\u306e\u96c6\u5ba2\u306f\u91cd\u8981\u3067\u3059\u304c\u3001\u624b\u4f5c\u696d\u3067\u306e\u6295\u7a3f\u3084\u5206\u6790\u306f\u6642\u9593\u306e\u7121\u99c4\u3067\u3059\u3002 \u30b9\u30de\u30fc\u30c8\u3067\u52b9\u7387\u7684\u306a\u30a2\u30ab\u30a6\u30f3\u30c8\u904b\u7528\u30c4\u30fc\u30eb\u300cSocialDog\u300d\u3092\u5c0e\u5165\u3059\u308b\u3053\u3068\u3067\u3001\u30de\u30fc\u30b1\u30c6\u30a3\u30f3\u30b0\u696d\u52d9\u306f\u5287\u7684\u306b\u6539\u5584\u3057\u307e\u3059\u3002</p>"},{"location":"articles/socialdog-review/#_1","title":"\u4e3b\u306a\u6a5f\u80fd\u3068\u30e1\u30ea\u30c3\u30c8","text":"<p>\u4e88\u7d04\u6295\u7a3f\u3001\u9ad8\u5ea6\u306a\u30d5\u30a9\u30ed\u30ef\u30fc\u5206\u6790\u3001\u81ea\u52d5\u5316\u6a5f\u80fd\u3092\u5099\u3048\u3066\u304a\u308a\u3001\u500b\u4eba\u304b\u3089\u30a8\u30f3\u30bf\u30fc\u30d7\u30e9\u30a4\u30ba\u307e\u3067\u5e45\u5e83\u304f\u652f\u6301\u3055\u308c\u3066\u3044\u307e\u3059\u3002AI\u3067\u751f\u6210\u3057\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u5168\u81ea\u52d5\u3067\u914d\u4fe1\u3059\u308b\u30b7\u30b9\u30c6\u30e0\u69cb\u7bc9\u306b\u6700\u9069\u3067\u3059\u3002</p> <p>\ud83d\udc49 \u30b9\u30de\u30fc\u30c8\u3067\u52b9\u7387\u7684\u306a Twitter \u30a2\u30ab\u30a6\u30f3\u30c8\u904b\u7528\u30c4\u30fc\u30eb SocialDog</p>"},{"location":"articles/taketin-review/","title":"TAKETIN(\u30bf\u30b1\u30c1\u30f3)\u306e\u8a55\u5224\u30fb\u6599\u91d1\u3092\u5fb9\u5e95\u89e3\u8aac\uff01\u4f1a\u54e1\u5236\u30d3\u30b8\u30cd\u30b9\u3092\u5b8c\u5168\u81ea\u52d5\u5316","text":"<p>\u203b\u3053\u306e\u8a18\u4e8b\u306b\u306fPR\uff08\u30d7\u30ed\u30e2\u30fc\u30b7\u30e7\u30f3\uff09\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"articles/taketin-review/#taketin","title":"TAKETIN(\u30bf\u30b1\u30c1\u30f3)\u306e\u8a55\u5224\u30fb\u6599\u91d1\u3092\u5fb9\u5e95\u89e3\u8aac\uff01\u4f1a\u54e1\u5236\u30d3\u30b8\u30cd\u30b9\u3092\u5b8c\u5168\u81ea\u52d5\u5316","text":"<p>\u300c\u30aa\u30f3\u30e9\u30a4\u30f3\u30b5\u30ed\u30f3\u3084\u30b9\u30af\u30fc\u30eb\u3092\u7acb\u3061\u4e0a\u3052\u305f\u306f\u3044\u3044\u304c\u3001\u6bce\u6708\u306e\u6c7a\u6e08\u78ba\u8a8d\u3068\u4f1a\u54e1\u7ba1\u7406\u3067\u624b\u4e00\u676f\u2026\u300d \u305d\u3093\u306a\u904b\u55b6\u8005\u306e\u60a9\u307f\u3092\u4e00\u6483\u3067\u89e3\u6c7a\u3059\u308b\u306e\u304c\u3001\u30ce\u30fc\u30b3\u30fc\u30c9SaaS\u306eTAKETIN\uff08\u30bf\u30b1\u30c1\u30f3\uff09\u3067\u3059\u3002</p> <p>\u672c\u8a18\u4e8b\u3067\u306f\u3001TAKETIN\u3092\u5c0e\u5165\u3059\u3079\u304d\u7406\u7531\u3001\u5177\u4f53\u7684\u306a\u6599\u91d1\u30d7\u30e9\u30f3\u3001\u305d\u3057\u3066\u30e1\u30ea\u30c3\u30c8\u30fb\u30c7\u30e1\u30ea\u30c3\u30c8\u3092\u6b63\u76f4\u306b\u30ec\u30d3\u30e5\u30fc\u3057\u307e\u3059\u3002</p>"},{"location":"articles/taketin-review/#taketin_1","title":"TAKETIN\u3068\u306f\uff1f","text":"<p>TAKETIN\u306f\u3001\u4f1a\u54e1\u5236\u30d3\u30b8\u30cd\u30b9\uff08\u30aa\u30f3\u30e9\u30a4\u30f3\u30b5\u30ed\u30f3\u3001\u30b9\u30af\u30fc\u30eb\u3001\u30b3\u30f3\u30c6\u30f3\u30c4\u8ca9\u58f2\u306a\u3069\uff09\u306b\u5fc5\u8981\u306a\u6a5f\u80fd\u3092\u3059\u3079\u30661\u3064\u306b\u307e\u3068\u3081\u305f\u30aa\u30fc\u30eb\u30a4\u30f3\u30ef\u30f3\u306e\u81ea\u52d5\u5316\u30c4\u30fc\u30eb\u3067\u3059\u3002</p> <ul> <li>\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u7d99\u7d9a\u8ab2\u91d1</li> <li>\u30b9\u30c6\u30c3\u30d7\u30e1\u30fc\u30eb\u30fb\u30e1\u30eb\u30de\u30ac\u914d\u4fe1</li> <li>\u4f1a\u54e1\u30b5\u30a4\u30c8\u306e\u69cb\u7bc9</li> <li>\u9000\u4f1a\u8005\u306e\u81ea\u52d5\u30d5\u30a9\u30ed\u30fc</li> </ul> <p>\u3053\u308c\u3089\u3092\u8907\u6570\u306e\u30c4\u30fc\u30eb\uff08Stripe\u3001Mailchimp\u3001WordPress\u7b49\uff09\u3067\u30d0\u30e9\u30d0\u30e9\u306b\u7ba1\u7406\u3057\u3066\u3044\u308b\u3068\u3001\u9023\u643a\u30a8\u30e9\u30fc\u3067\u300c\u4f1a\u8cbb\u3092\u6255\u3063\u3066\u3044\u306a\u3044\u306e\u306b\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u898b\u308c\u3066\u3044\u308b\u300d\u3068\u3044\u3063\u305f\u81f4\u547d\u7684\u306a\u6f0f\u308c\u304c\u767a\u751f\u3057\u307e\u3059\u3002TAKETIN\u306a\u3089\u3053\u308c\u3089\u304c\u5168\u3066\u9023\u52d5\u3057\u307e\u3059\u3002</p>"},{"location":"articles/taketin-review/#_1","title":"\u6599\u91d1\u30d7\u30e9\u30f3","text":"<ul> <li>\u521d\u671f\u8cbb\u7528: \u8981\u554f\u3044\u5408\u308f\u305b\uff08\u203b\u7121\u6599\u76f8\u8ac7\u3067\u30d3\u30b8\u30cd\u30b9\u898f\u6a21\u306b\u5408\u308f\u305b\u305f\u63d0\u6848\u3042\u308a\uff09</li> <li>\u6708\u984d\u8cbb\u7528: \u904b\u55b6\u898f\u6a21\u306b\u5fdc\u3058\u305f\u5f93\u91cf\u8ab2\u91d1\u3001\u307e\u305f\u306f\u56fa\u5b9a\u30d7\u30e9\u30f3</li> </ul> <p>\ud83d\udc49 \u4f1a\u54e1\u5236\u30d3\u30b8\u30cd\u30b9\u306e\u904b\u55b6\u3092\u4e38\u3054\u3068\u81ea\u52d5\u5316\uff01\u30ce\u30fc\u30b3\u30fc\u30c9SaaS\u3010TAKETIN\u3011\uff08\u7121\u6599\u30aa\u30f3\u30e9\u30a4\u30f3\u76f8\u8ac7\u306f\u3053\u3061\u3089\uff09</p>"},{"location":"articles/taketin-review/#_2","title":"\u30e1\u30ea\u30c3\u30c8\u30fb\u30c7\u30e1\u30ea\u30c3\u30c8","text":""},{"location":"articles/taketin-review/#3","title":"\u5727\u5012\u7684\u306a3\u3064\u306e\u30e1\u30ea\u30c3\u30c8","text":"<ol> <li>\u7a76\u6975\u306e\u300c\u624b\u653e\u3057\u300d\u904b\u55b6\u304c\u53ef\u80fd\uff1a\u6c7a\u6e08\u304c\u6b62\u307e\u3063\u305f\u4f1a\u54e1\u3092\u81ea\u52d5\u3067\u30b7\u30b9\u30c6\u30e0\u304b\u3089\u9664\u5916\u3059\u308b\u305f\u3081\u3001\u624b\u52d5\u306e\u7a81\u5408\u78ba\u8a8d\u304c\u30bc\u30ed\u306b\u306a\u308a\u307e\u3059\u3002</li> <li>\u30ce\u30fc\u30b3\u30fc\u30c9\u3067\u5c02\u9580\u77e5\u8b58\u4e0d\u8981\uff1a\u30d7\u30ed\u30b0\u30e9\u30df\u30f3\u30b0\u306e\u77e5\u8b58\u304c\u306a\u304f\u3066\u3082\u3001\u76f4\u611f\u7684\u306b\u4f1a\u54e1\u30b5\u30a4\u30c8\u304c\u4f5c\u308c\u307e\u3059\u3002</li> <li>LTV\uff08\u9867\u5ba2\u751f\u6daf\u4fa1\u5024\uff09\u306e\u6700\u5927\u5316\uff1a\u9000\u4f1a\u3057\u305d\u3046\u306a\u30e6\u30fc\u30b6\u30fc\u3092\u691c\u77e5\u3057\u3001\u81ea\u52d5\u3067\u30d5\u30a9\u30ed\u30fc\u30a2\u30c3\u30d7\u30e1\u30fc\u30eb\u3092\u9001\u308b\u4ed5\u7d44\u307f\u304c\u79c0\u9038\u3067\u3059\u3002</li> </ol>"},{"location":"articles/taketin-review/#_3","title":"\u30c7\u30e1\u30ea\u30c3\u30c8\uff08\u6ce8\u610f\u70b9\uff09","text":"<ol> <li>\u5c0f\u898f\u6a21\u3059\u304e\u308b\u30d3\u30b8\u30cd\u30b9\u306b\u306f\u30aa\u30fc\u30d0\u30fc\u30b9\u30da\u30c3\u30af\uff1a\u4f1a\u54e1\u6570\u304c\u6570\u540d\u7a0b\u5ea6\u306e\u5834\u5408\u3001\u624b\u6570\u6599\u3092\u6255\u3063\u3066\u624b\u52d5\u3067\u7ba1\u7406\u3057\u305f\u65b9\u304c\u5b89\u3044\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u672c\u683c\u7684\u306a\u4e8b\u696d\u62e1\u5927\u3092\u898b\u636e\u3048\u308b\u65b9\u5411\u3051\u3067\u3059\u3002</li> </ol>"},{"location":"articles/taketin-review/#_4","title":"\u30e6\u30fc\u30b6\u30fc\u306e\u53e3\u30b3\u30df\uff08\u533f\u540d\uff09","text":"<ul> <li>\u300c\u4eca\u307e\u3067\u6708\u672b\u306b\u306a\u308b\u3068\u4f1a\u54e1\u306e\u632f\u308a\u8fbc\u307f\u78ba\u8a8d\u30673\u65e5\u5fb9\u591c\u3057\u3066\u3044\u307e\u3057\u305f\u304c\u3001TAKETIN\u3092\u5165\u308c\u3066\u304b\u3089\u78ba\u8a8d\u4f5c\u696d\u304c0\u79d2\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u795e\u30c4\u30fc\u30eb\u3067\u3059\u3002\u300d\uff0830\u4ee3\u30fb\u30b9\u30af\u30fc\u30eb\u904b\u55b6\uff09</li> <li>\u300c\u8907\u6570\u306e\u30c4\u30fc\u30eb\u3092\u89e3\u7d04\u3057\u3066TAKETIN\u4e00\u672c\u306b\u7d5e\u3063\u305f\u7d50\u679c\u3001\u30b7\u30b9\u30c6\u30e0\u7dad\u6301\u8cbb\u3082\u4e0b\u304c\u308a\u3001\u4f55\u3088\u308a\u7cbe\u795e\u7684\u306a\u30b9\u30c8\u30ec\u30b9\u304c\u6d88\u3048\u307e\u3057\u305f\u3002\u300d\uff0840\u4ee3\u30fb\u30b5\u30ed\u30f3\u30aa\u30fc\u30ca\u30fc\uff09</li> </ul>"},{"location":"articles/taketin-review/#taketin_2","title":"\u307e\u3068\u3081\uff1aTAKETIN\u306f\u5c0e\u5165\u3059\u3079\u304d\u304b\uff1f","text":"<p>\u4f1a\u54e1\u5236\u30d3\u30b8\u30cd\u30b9\u306b\u304a\u3044\u3066\u300c\u904b\u55b6\u306e\u81ea\u52d5\u5316\u300d\u306f\u5229\u76ca\u306b\u76f4\u7d50\u3057\u307e\u3059\u3002 \u4e8b\u52d9\u4f5c\u696d\u306b\u8ffd\u308f\u308c\u3066\u3044\u308b\u6687\u304c\u3042\u308b\u306a\u3089\u3001\u65b0\u3057\u3044\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u4f5c\u3063\u305f\u308a\u3001\u96c6\u5ba2\u306b\u6642\u9593\u3092\u4f7f\u3046\u3079\u304d\u3067\u3059\u3002\u307e\u305a\u306f\u7121\u6599\u306e\u30aa\u30f3\u30e9\u30a4\u30f3\u76f8\u8ac7\u3067\u3001\u81ea\u793e\u306e\u30d3\u30b8\u30cd\u30b9\u306b\u3069\u3046\u7d44\u307f\u8fbc\u3081\u308b\u304b\u63d0\u6848\u3092\u53d7\u3051\u3066\u307f\u308b\u3053\u3068\u3092\u5f37\u304f\u304a\u3059\u3059\u3081\u3057\u307e\u3059\u3002</p> <p>\ud83d\udc49 TAKETIN \u7121\u6599\u30aa\u30f3\u30e9\u30a4\u30f3\u76f8\u8ac7\u306b\u7533\u3057\u8fbc\u3080</p>"},{"location":"articles/xserver-vps/","title":"XServer VPS \u30af\u30e9\u30a6\u30c9\u306e\u8a55\u5224\uff1a\u81ea\u793e\u30a2\u30d7\u30ea\u69cb\u7bc9\u306b\u6700\u9069\u306a\u6700\u5f37\u30a4\u30f3\u30d5\u30e9","text":"<p>\u72ec\u81ea\u306eAI\u30c4\u30fc\u30eb\u3092\u30db\u30b9\u30c6\u30a3\u30f3\u30b0\u3057\u305f\u308a\u3001\u5927\u898f\u6a21\u306aWeb\u30b5\u30fc\u30d3\u30b9\u3092\u5c55\u958b\u3059\u308b\u969b\u3001\u30a4\u30f3\u30d5\u30e9\u306e\u69cb\u7bc9\u30b9\u30d4\u30fc\u30c9\u3068\u5b89\u5b9a\u6027\u304c\u30d3\u30b8\u30cd\u30b9\u306e\u660e\u6697\u3092\u5206\u3051\u307e\u3059\u3002</p>"},{"location":"articles/xserver-vps/#xserver-vps_1","title":"XServer VPS \u30af\u30e9\u30a6\u30c9\u306e\u30e1\u30ea\u30c3\u30c8","text":"<p>\u56fd\u5185\u30b7\u30a7\u30a2No.1\u306eXServer\u304c\u63d0\u4f9b\u3059\u308b\u30af\u30e9\u30a6\u30c9\u74b0\u5883\u3067\u3059\u3002\u7528\u9014\u306b\u5408\u308f\u305b\u3066\u9078\u3076\u3060\u3051\u3067\u81ea\u52d5\u69cb\u7bc9\u3055\u308c\u308b\u624b\u8efd\u3055\u3068\u3001\u5727\u5012\u7684\u306a\u51e6\u7406\u901f\u5ea6\uff08NVMe\u63a1\u7528\uff09\u304c\u9b45\u529b\u3067\u3059\u3002\u958b\u767a\u306b\u96c6\u4e2d\u3057\u305f\u3044\u30a8\u30f3\u30b8\u30cb\u30a2\u3084\u4e8b\u696d\u4e3b\u306b\u3068\u3063\u3066\u3001\u6700\u9ad8\u306e\u30a4\u30f3\u30d5\u30e9\u74b0\u5883\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002</p> <p>\ud83d\udc49 XServer VPS \u30af\u30e9\u30a6\u30c9</p>"}]}