{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"AI Tool Compass \u3078\u3088\u3046\u3053\u305d","text":"<p>\u5f53\u30b5\u30a4\u30c8\u3067\u306f\u3001\u6700\u65b0\u306eAI\u30c4\u30fc\u30eb\u3084\u696d\u52d9\u52b9\u7387\u5316SaaS\u3092\u5fb9\u5e95\u7684\u306b\u691c\u8a3c\u3057\u3001\u8aad\u8005\u306e\u7686\u69d8\u306e\u751f\u7523\u6027\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u30c4\u30fc\u30eb\u3092\u3054\u63d0\u6848\u3057\u307e\u3059\u3002</p>"},{"location":"#_1","title":"\u6ce8\u76ee\u306e\u30ab\u30c6\u30b4\u30ea\u30fc","text":"<ul> <li>\u751f\u6210AI\u30c4\u30fc\u30eb (Generative AI)</li> <li>\u30ce\u30fc\u30b3\u30fc\u30c9\u958b\u767a (No-Code)</li> <li>SEO\u30fb\u30de\u30fc\u30b1\u30c6\u30a3\u30f3\u30b0\u81ea\u52d5\u5316</li> </ul> <p>\u203b\u5f53\u30b5\u30a4\u30c8\u306f\u81ea\u5f8b\u578bAI\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u306b\u3088\u3063\u3066\u3001\u5e38\u306b\u6700\u65b0\u306e\u691c\u7d22\u30c8\u30ec\u30f3\u30c9\u3068\u60c5\u5831\u306b\u57fa\u3065\u304d\u81ea\u52d5\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3055\u308c\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"articles/accounting-tools/","title":"\u30102026\u5e74\u6700\u65b0\u3011\u30af\u30e9\u30a6\u30c9\u4f1a\u8a08\u30bd\u30d5\u30c8\u5fb9\u5e95\u6bd4\u8f03\uff1a\u500b\u4eba\u4e8b\u696d\u4e3b\u30fb\u30d5\u30ea\u30fc\u30e9\u30f3\u30b9\u306b\u304a\u3059\u3059\u30813\u9078","text":"<p>\u65e5\u3005\u306e\u7d4c\u7406\u4f5c\u696d\u3084\u78ba\u5b9a\u7533\u544a\u3092\u5287\u7684\u306b\u697d\u306b\u3059\u308b\u30af\u30e9\u30a6\u30c9\u4f1a\u8a08\u30bd\u30d5\u30c8\u3002 \u672c\u8a18\u4e8b\u3067\u306f\u3001AI\u3084\u81ea\u52d5\u4ed5\u8a33\u6a5f\u80fd\u3092\u5099\u3048\u305f\u696d\u754c\u30c8\u30c3\u30d73\u306eSaaS\u3092\u5fb9\u5e95\u6bd4\u8f03\u3057\u307e\u3059\u3002</p> \ud83e\udd16 10\u79d2\u8a3a\u65ad\uff1a\u3042\u306a\u305f\u306b\u6700\u9069\u306a\u4f1a\u8a08\u30bd\u30d5\u30c8\u306f\uff1f <p>\u7c3f\u8a18\u306e\u77e5\u8b58\u306f\u3042\u308a\u307e\u3059\u304b\uff1f</p> \u77e5\u8b58\u30bc\u30ed\uff08\u3068\u306b\u304b\u304f\u7c21\u5358\u306b\uff09 \u3042\u308b\u7a0b\u5ea6\u308f\u304b\u308b\uff08\u81ea\u52d5\u5316\u91cd\u8996\uff09 <p></p> <p>\u3054\u81ea\u8eab\u306e\u4e8b\u696d\u898f\u6a21\u306b\u5408\u3063\u305f\u30c4\u30fc\u30eb\u3092\u9078\u3073\u307e\u3057\u3087\u3046\u3002</p>"},{"location":"articles/accounting-tools/#1-freee","title":"1. freee\u4f1a\u8a08 (\u30d5\u30ea\u30fc)","text":"<p>\u7c3f\u8a18\u306e\u77e5\u8b58\u304c\u306a\u304f\u3066\u3082\u76f4\u611f\u7684\u306b\u64cd\u4f5c\u3067\u304d\u308b\u306e\u304c\u6700\u5927\u306e\u9b45\u529b\u3067\u3059\u3002\u9280\u884c\u53e3\u5ea7\u3068\u306e\u9023\u643a\u306f\u3082\u3061\u308d\u3093\u3001\u30b9\u30de\u30db\u30a2\u30d7\u30ea\u304b\u3089\u306e\u30ec\u30b7\u30fc\u30c8\u64ae\u5f71\u306b\u3082\u5bfe\u5fdc\u3057\u3066\u304a\u308a\u3001\u500b\u4eba\u4e8b\u696d\u4e3b\u306e\u5f37\u3044\u5473\u65b9\u3067\u3059\u3002</p> <p>\ud83d\udc49 freee\u4f1a\u8a08\u3010freee\u4f1a\u8a08\u3011</p>"},{"location":"articles/accounting-tools/#2","title":"2. \u30de\u30cd\u30fc\u30d5\u30a9\u30ef\u30fc\u30c9 \u30af\u30e9\u30a6\u30c9\u78ba\u5b9a\u7533\u544a","text":"<p>\u4ed6\u30b5\u30fc\u30d3\u30b9\uff08\u9280\u884c\u3001\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u3001\u30ec\u30b8\u306a\u3069\uff09\u3068\u306e\u9023\u643a\u529b\u306e\u5f37\u3055\u304c\u5727\u5012\u7684\u3067\u3059\u3002\u4e8b\u696d\u304c\u62e1\u5927\u3057\u3001\u69d8\u3005\u306a\u30c4\u30fc\u30eb\u3092\u5c0e\u5165\u3057\u3066\u3044\u3066\u3082\u3001\u4f1a\u8a08\u696d\u52d9\u3092\u7d041/2\u306b\u524a\u6e1b\u3067\u304d\u308b\u30dd\u30c6\u30f3\u30b7\u30e3\u30eb\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002</p> <p>\ud83d\udc49 \u81ea\u52d5\u5316\u3067\u30ab\u30f3\u30bf\u30f3\u306b\u66f8\u985e\u4f5c\u6210 \u30de\u30cd\u30fc\u30d5\u30a9\u30ef\u30fc\u30c9 \u30af\u30e9\u30a6\u30c9\u78ba\u5b9a\u7533\u544a</p>"},{"location":"articles/accounting-tools/#3","title":"3. \u5f25\u751f\u30b7\u30ea\u30fc\u30ba (\u3084\u3088\u3044\u306e\u9752\u8272\u7533\u544a\u30aa\u30f3\u30e9\u30a4\u30f3)","text":"<p>\u58f2\u4e0a\u5b9f\u7e3eNo.1\u3002\u9577\u5e74\u306e\u4fe1\u983c\u3068\u624b\u539a\u3044\u30b5\u30dd\u30fc\u30c8\u4f53\u5236\u304c\u3042\u308a\u3001\u521d\u3081\u3066\u306e\u78ba\u5b9a\u7533\u544a\u3067\u3082\u8ff7\u308f\u305a\u9032\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002</p> <p>\ud83d\udc49 \u5f25\u751f\u7d66\u4e0e Next\u306f\u3053\u3061\u3089</p>"},{"location":"articles/doraverse-review/","title":"Doraverse\u306e\u8a55\u5224\u3068\u4f7f\u3044\u65b9\uff1a\u8907\u6570AI\u30b5\u30d6\u30b9\u30af\u3092\u4e00\u672c\u5316\u3059\u308b\u6700\u5f37\u30c4\u30fc\u30eb","text":"<p>ChatGPT\u3001Claude\u3001Midjourney... \u6709\u80fd\u306aAI\u30c4\u30fc\u30eb\u304c\u5897\u3048\u308b\u4e00\u65b9\u3067\u3001\u5168\u3066\u3092\u5951\u7d04\u3059\u308b\u3068\u6708\u984d\u30b3\u30b9\u30c8\u306f\u6570\u4e07\u5186\u306b\u81a8\u308c\u4e0a\u304c\u308a\u307e\u3059\u3002 \u305d\u3053\u3067\u73fe\u5728\u3001\u6cd5\u4eba\u306e\u30b3\u30b9\u30c8\u524a\u6e1b\u3068\u696d\u52d9\u52b9\u7387\u5316\u306e\u5207\u308a\u672d\u3068\u3057\u3066\u6ce8\u76ee\u3055\u308c\u3066\u3044\u308b\u306e\u304c\u300cDoraverse\u300d\u3067\u3059\u3002</p>"},{"location":"articles/doraverse-review/#doraverse","title":"Doraverse\u3068\u306f\uff1f","text":"<p>\u8907\u6570\u306e\u6700\u9ad8\u5cf0AI\u30e2\u30c7\u30eb\u30921\u3064\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u4f7f\u3044\u5012\u305b\u308bBtoB\u5411\u3051SaaS\u3067\u3059\u3002\u30c1\u30fc\u30e0\u5168\u4f53\u3067AI\u306e\u77e5\u80fd\u3092\u5171\u6709\u3057\u3001\u5727\u5012\u7684\u306a\u751f\u7523\u6027\u5411\u4e0a\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002</p> <p>\ud83d\udc49 \u6708\u984d\u6599\u91d1\u3092\u8ce2\u304f\u96c6\u7d04\u3002\u8907\u6570\u306eAI\u30b5\u30d6\u30b9\u30af\u30921\u3064\u306b\u307e\u3068\u3081\u3066\u3001\u6700\u9ad8\u5cf0\u306e\u77e5\u80fd\u3092\u4f7f\u3044\u5012\u3059\u306a\u3089Doraverse\u3002</p>"},{"location":"articles/socialdog-review/","title":"SocialDog\u306e\u6599\u91d1\u30d7\u30e9\u30f3\u3068\u8a55\u5224\uff1aSNS\u904b\u7528\u3092\u5b8c\u5168\u81ea\u52d5\u5316\u3059\u308b\u65b9\u6cd5","text":"<p>X\uff08\u65e7Twitter\uff09\u3067\u306e\u96c6\u5ba2\u306f\u91cd\u8981\u3067\u3059\u304c\u3001\u624b\u4f5c\u696d\u3067\u306e\u6295\u7a3f\u3084\u5206\u6790\u306f\u6642\u9593\u306e\u7121\u99c4\u3067\u3059\u3002 \u30b9\u30de\u30fc\u30c8\u3067\u52b9\u7387\u7684\u306a\u30a2\u30ab\u30a6\u30f3\u30c8\u904b\u7528\u30c4\u30fc\u30eb\u300cSocialDog\u300d\u3092\u5c0e\u5165\u3059\u308b\u3053\u3068\u3067\u3001\u30de\u30fc\u30b1\u30c6\u30a3\u30f3\u30b0\u696d\u52d9\u306f\u5287\u7684\u306b\u6539\u5584\u3057\u307e\u3059\u3002</p>"},{"location":"articles/socialdog-review/#_1","title":"\u4e3b\u306a\u6a5f\u80fd\u3068\u30e1\u30ea\u30c3\u30c8","text":"<p>\u4e88\u7d04\u6295\u7a3f\u3001\u9ad8\u5ea6\u306a\u30d5\u30a9\u30ed\u30ef\u30fc\u5206\u6790\u3001\u81ea\u52d5\u5316\u6a5f\u80fd\u3092\u5099\u3048\u3066\u304a\u308a\u3001\u500b\u4eba\u304b\u3089\u30a8\u30f3\u30bf\u30fc\u30d7\u30e9\u30a4\u30ba\u307e\u3067\u5e45\u5e83\u304f\u652f\u6301\u3055\u308c\u3066\u3044\u307e\u3059\u3002AI\u3067\u751f\u6210\u3057\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u5168\u81ea\u52d5\u3067\u914d\u4fe1\u3059\u308b\u30b7\u30b9\u30c6\u30e0\u69cb\u7bc9\u306b\u6700\u9069\u3067\u3059\u3002</p> <p>\ud83d\udc49 \u30b9\u30de\u30fc\u30c8\u3067\u52b9\u7387\u7684\u306a Twitter \u30a2\u30ab\u30a6\u30f3\u30c8\u904b\u7528\u30c4\u30fc\u30eb SocialDog</p>"},{"location":"articles/xserver-vps/","title":"XServer VPS \u30af\u30e9\u30a6\u30c9\u306e\u8a55\u5224\uff1a\u81ea\u793e\u30a2\u30d7\u30ea\u69cb\u7bc9\u306b\u6700\u9069\u306a\u6700\u5f37\u30a4\u30f3\u30d5\u30e9","text":"<p>\u72ec\u81ea\u306eAI\u30c4\u30fc\u30eb\u3092\u30db\u30b9\u30c6\u30a3\u30f3\u30b0\u3057\u305f\u308a\u3001\u5927\u898f\u6a21\u306aWeb\u30b5\u30fc\u30d3\u30b9\u3092\u5c55\u958b\u3059\u308b\u969b\u3001\u30a4\u30f3\u30d5\u30e9\u306e\u69cb\u7bc9\u30b9\u30d4\u30fc\u30c9\u3068\u5b89\u5b9a\u6027\u304c\u30d3\u30b8\u30cd\u30b9\u306e\u660e\u6697\u3092\u5206\u3051\u307e\u3059\u3002</p>"},{"location":"articles/xserver-vps/#xserver-vps_1","title":"XServer VPS \u30af\u30e9\u30a6\u30c9\u306e\u30e1\u30ea\u30c3\u30c8","text":"<p>\u56fd\u5185\u30b7\u30a7\u30a2No.1\u306eXServer\u304c\u63d0\u4f9b\u3059\u308b\u30af\u30e9\u30a6\u30c9\u74b0\u5883\u3067\u3059\u3002\u7528\u9014\u306b\u5408\u308f\u305b\u3066\u9078\u3076\u3060\u3051\u3067\u81ea\u52d5\u69cb\u7bc9\u3055\u308c\u308b\u624b\u8efd\u3055\u3068\u3001\u5727\u5012\u7684\u306a\u51e6\u7406\u901f\u5ea6\uff08NVMe\u63a1\u7528\uff09\u304c\u9b45\u529b\u3067\u3059\u3002\u958b\u767a\u306b\u96c6\u4e2d\u3057\u305f\u3044\u30a8\u30f3\u30b8\u30cb\u30a2\u3084\u4e8b\u696d\u4e3b\u306b\u3068\u3063\u3066\u3001\u6700\u9ad8\u306e\u30a4\u30f3\u30d5\u30e9\u74b0\u5883\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002</p> <p>\ud83d\udc49 XServer VPS \u30af\u30e9\u30a6\u30c9</p>"}]}